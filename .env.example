# Copy this file to .env and fill it in.  .env is in .gitignore, so your keys never go to GitHub.
# Everything works in "simulated calls" mode with this file untouched.

# ---- Push alerts to the neighbor's phone (free, no account) ----
# Install the ntfy app, subscribe to a hard-to-guess topic, and put the same topic here.
NTFY_TOPIC=

# ---- Real phone calls (Twilio) ----
# Leave these blank to keep calls simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # your Twilio number, like +14045551234
PUBLIC_BASE_URL=             # your cloudflared URL, like https://abc-def.trycloudflare.com (no trailing slash)

# Who gets called. Use +1XXXXXXXXXX format.
RESIDENT_PHONE=              # the "senior" (for the demo: a phone you hand the judge)
RESIDENT_LANGUAGE=en         # en or es
NEIGHBOR_NAME=Denise (neighbor)
NEIGHBOR_PHONE=              # optional: also call the neighbor, not just push-alert them

# ---- Live outdoor weather (Open-Meteo, free, no key) ----
WEATHER=true                 # false turns it off
WEATHER_REFRESH_MINUTES=10   # how often to fetch
SENSOR_STALE_MINUTES=5       # no indoor reading for this long -> check-ins use outdoor weather

# ---- Tuning ----
ALERT_HEAT_INDEX_F=90        # NWS "extreme caution" starts at 90
ALERT_CONSECUTIVE_READINGS=2 # hot readings in a row before calling
RECHECK_MINUTES=30           # call again this long after "I'm OK" if it's still hot
SAMPLE_HOMES=true            # show the 3 sample homes in the sidebar
SIMULATE_CALLS=false         # true = never place real calls, even if Twilio is set up
DEVICE_KEY=                  # optional shared secret the sensor must send
PORT=8000
